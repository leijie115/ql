#!name=萱子签到参数自动更新
#!desc=进入萱子小程序签到页自动抓取 memberId 等身份参数并更新到青龙面板 XUANZI 环境变量
#!author=leos
#!icon=https://raw.githubusercontent.com/Koolson/Qure/master/IconSet/Color/Cookie.png

[Argument]
ql_url = input,"",tag=青龙面板地址,desc=如 https://ql.example.com
ql_client_id = input,"",tag=Client ID,desc=青龙应用 Client ID
ql_client_secret = input,"",tag=Client Secret,desc=青龙应用 Client Secret
account_name = input,"",tag=账号备注,desc=留空则用 memberId 后6位, 多账号建议各自填写
cron_search = input,"xuanzi_sign",tag=签到任务关键词,desc=留空则只更新环境变量
tg_bot_token = input,"",tag=TG Bot Token,desc=Telegram Bot Token(可选)
tg_chat_id = input,"",tag=TG Chat ID,desc=Telegram Chat ID(可选)

[Script]
http-request ^https:\/\/hope\.demogic\.com\/gic-wx-app\/sign\/get-member-sign-info\.json\? script-path=https://raw.githubusercontent.com/leijie115/ql/main/loon/xuanzi/xuanzi_token.js, tag=萱子签到参数, argument=[{ql_url},{ql_client_id},{ql_client_secret},{account_name},{cron_search},{tg_bot_token},{tg_chat_id}]

[MITM]
hostname = hope.demogic.com
